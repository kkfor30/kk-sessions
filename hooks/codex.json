{
  "description": "kk-sessions：新会话启动说明 + 每轮 ⏳ 提醒 + 新会话前几轮结束后在后台改标题、归分区",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 \"${PLUGIN_ROOT}/skills/kk-session-route/scripts/session_start.py\"",
            "commandWindows": "py -3 -X utf8 \"${PLUGIN_ROOT}/skills/kk-session-route/scripts/session_start.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 \"${PLUGIN_ROOT}/skills/kk-session-route/scripts/turn_hint.py\"",
            "commandWindows": "py -3 -X utf8 \"${PLUGIN_ROOT}/skills/kk-session-route/scripts/turn_hint.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 \"${PLUGIN_ROOT}/skills/kk-session-route/scripts/codex_route.py\"",
            "commandWindows": "py -3 -X utf8 \"${PLUGIN_ROOT}/skills/kk-session-route/scripts/codex_route.py\""
          }
        ]
      }
    ]
  }
}